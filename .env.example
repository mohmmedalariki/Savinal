# Telegram Bot Token (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_token_here

# Download Settings
MAX_CONCURRENT_DOWNLOADS=3
# Max file size in MB to send directly via Telegram (default limit is 50MB for bots without API server)
MAX_TELEGRAM_FILE_MB=45
DOWNLOAD_TIMEOUT_SECONDS=300

# S3 Configuration (Optional - for files larger than MAX_TELEGRAM_FILE_MB)
# If not provided, large files will be rejected or fallback to audio/lower quality
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# Region is often required for some S3 providers
AWS_REGION=us-east-1
